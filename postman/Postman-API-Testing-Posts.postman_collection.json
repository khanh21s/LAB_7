{
  "info": {
    "name": "Postman API Testing - Posts",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "TC-01 GET danh sach bai viet",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response is a JSON array with 5 posts\", function () {",
              "    const data = pm.response.json();",
              "    pm.expect(data).to.be.an(\"array\").with.lengthOf(5);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/posts?_limit=5",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts"
          ],
          "query": [
            {
              "key": "_limit",
              "value": "5"
            }
          ]
        }
      }
    },
    {
      "name": "TC-02 GET mot bai viet theo ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Post has the expected ID and fields\", function () {",
              "    const data = pm.response.json();",
              "    pm.expect(data.id).to.eql(1);",
              "    pm.expect(data.title).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(data.body).to.be.a(\"string\").and.not.empty;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/posts/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts",
            "1"
          ]
        }
      }
    },
    {
      "name": "TC-03 POST tao bai viet",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Response contains the submitted post data\", function () {",
              "    const data = pm.response.json();",
              "    pm.expect(data.title).to.eql(\"Bai viet kiem thu Postman\");",
              "    pm.expect(data.body).to.eql(\"Noi dung tao trong buoi thuc hanh\");",
              "    pm.expect(data.userId).to.eql(1);",
              "    pm.expect(data.id).to.exist;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/posts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Bai viet kiem thu Postman\",\n  \"body\": \"Noi dung tao trong buoi thuc hanh\",\n  \"userId\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "TC-04 PUT cap nhat toan bo",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response matches the updated post\", function () {",
              "    const data = pm.response.json();",
              "    pm.expect(data.title).to.eql(\"Tieu de da cap nhat bang PUT\");",
              "    pm.expect(data.body).to.eql(\"Noi dung cap nhat toan bo\");",
              "    pm.expect(data.userId).to.eql(1);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/posts/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts",
            "1"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": 1,\n  \"title\": \"Tieu de da cap nhat bang PUT\",\n  \"body\": \"Noi dung cap nhat toan bo\",\n  \"userId\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "TC-05 PATCH cap nhat mot phan",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response contains the updated title\", function () {",
              "    pm.expect(pm.response.json().title)",
              "        .to.eql(\"Chi cap nhat tieu de bang PATCH\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/posts/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts",
            "1"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Chi cap nhat tieu de bang PATCH\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
